{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "id": "/",
  "name": "KunekTayo",
  "short_name": "KunekTayo",
  "description": "Zero-knowledge, zero-footprint temporary 1-on-1 private voice, video, and vanishing chat for Windows, Android, and Web.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#1e1f22",
  "theme_color": "#1e1f22",
  "lang": "en",
